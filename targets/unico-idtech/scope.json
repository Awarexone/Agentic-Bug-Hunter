{
  "program": "Unico IDTech",
  "platform": "HackerOne",
  "program_url": "https://hackerone.com/unico",
  "safe_harbor": "Gold Standard",

  "domains": [
    "sdk-h1.unico.io"
  ],
  "excluded_domains": [],

  "scopes": {
